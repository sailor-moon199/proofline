# Add provider API keys here only for local development.
# Never commit real keys. Keep the actual values in an ignored .env file.
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434
LLM_PROVIDER=gemini
LLM_MODEL=
LLM_MIN_DELAY_SECONDS=0
LLM_MAX_RETRIES=3
LLM_BACKOFF_SECONDS=1.0
LLM_CACHE_DIR=.llm_cache
